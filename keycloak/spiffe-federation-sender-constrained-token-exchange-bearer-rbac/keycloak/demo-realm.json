{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "service1",
        "description": "Microservice 1 access role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "service2",
        "description": "Microservice 2 access role",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultDefaultClientScopes": [
    "email",
    "profile",
    "roles"
  ],
  "clients": [
    {
      "clientId": "frontend",
      "name": "Frontend Application",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-x509",
      "attributes": {
        "tls.client.certificate.bound.access.tokens": "true",
        "x509.subjectdn": ".*"
      },
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "https://localhost:8081",
      "baseUrl": "https://localhost:8081",
      "redirectUris": [
        "https://localhost:8081/*"
      ],
      "webOrigins": [
        "https://localhost:8081"
      ],
      "defaultClientScopes": [
        "email",
        "profile",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "microservice1-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "microservice1",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "microservice1",
      "name": "Microservice 1",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "federated-jwt",
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "tls.client.certificate.bound.access.tokens": "true",
        "jwt.credential.issuer": "spiffe",
        "jwt.credential.sub": "spiffe://demo.example.com/microservice1"
      },
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "email",
        "profile",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "microservice2-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "microservice2",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "mtls-certificate-bound-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-mtls-cnf-token-mapper",
          "consentRequired": false,
          "config": {}
        }
      ]
    },
    {
      "clientId": "microservice2",
      "name": "Microservice 2",
      "enabled": true,
      "publicClient": false,
      "secret": "microservice2-secret",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "tls.client.certificate.bound.access.tokens": "true"
      },
      "defaultClientScopes": [
        "email",
        "profile",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "spiffe",
      "providerId": "spiffe",
      "enabled": true,
      "config": {
        "trustDomain": "spiffe://demo.example.com",
        "bundleEndpoint": "https://spire-oidc:443/keys"
      }
    }
  ],
  "clientScopeMappings": {
    "microservice1": [
      {
        "client": "microservice2",
        "roles": []
      }
    ]
  },
  "users": [
    {
      "username": "ryan",
      "email": "ryan@example.og",
      "firstName": "Ryan",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "service1",
        "service2",
        "default-roles-demo"
      ]
    },
    {
      "username": "alice",
      "email": "alice@example.og",
      "firstName": "Alice",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "service1",
        "default-roles-demo"
      ]
    },
    {
      "username": "alan",
      "email": "alan@example.og",
      "firstName": "Alan",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-demo"
      ]
    },
    {
      "username": "service-account-microservice1",
      "enabled": true,
      "emailVerified": false,
      "serviceAccountClientId": "microservice1",
      "realmRoles": [
        "default-roles-demo"
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "microservice1",
      "roles": [
        "service1",
        "service2"
      ]
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-generated",
        "providerId": "rsa-generated",
        "config": {
          "priority": [
            "100"
          ]
        }
      },
      {
        "name": "hmac-generated",
        "providerId": "hmac-generated",
        "config": {
          "priority": [
            "100"
          ],
          "algorithm": [
            "HS256"
          ]
        }
      }
    ]
  }
}

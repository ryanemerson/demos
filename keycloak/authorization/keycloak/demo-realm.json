{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "manager",
        "description": "Manager role - grants access to all user profiles and team pages"
      },
      {
        "name": "user",
        "description": "Default user role"
      }
    ]
  },
  "defaultRoles": ["user"],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Smith",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "default-roles-demo"],
      "attributes": {
        "team": ["engineering"]
      }
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Jones",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "default-roles-demo"],
      "attributes": {
        "team": ["marketing"]
      }
    },
    {
      "username": "charlie",
      "enabled": true,
      "email": "charlie@example.com",
      "firstName": "Charlie",
      "lastName": "Brown",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "manager", "default-roles-demo"],
      "attributes": {
        "team": ["engineering"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "authorization-demo",
      "name": "Authorization Demo",
      "enabled": true,
      "publicClient": false,
      "secret": "authorization-demo-secret",
      "redirectUris": ["http://localhost:8081/*"],
      "webOrigins": ["http://localhost:8081"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "team-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "team",
            "claim.name": "team",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "scopes": [
          {
            "name": "view"
          }
        ],
        "resources": [
          {
            "name": "User Resource",
            "uris": ["/users/*"],
            "type": "urn:authorization-demo:resources:user",
            "scopes": [
              { "name": "view" }
            ]
          },
          {
            "name": "Team Resource",
            "uris": ["/teams/*"],
            "type": "urn:authorization-demo:resources:team",
            "scopes": [
              { "name": "view" }
            ]
          },
          {
            "name": "Default Resource",
            "uris": ["/*"],
            "type": "urn:authorization-demo:resources:default"
          }
        ],
        "policies": [
          {
            "name": "Authenticated Users Policy",
            "description": "Allows access to any authenticated user",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"user\",\"required\":true}]"
            }
          },
          {
            "name": "Manager Role Policy",
            "description": "Requires the manager realm role",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"manager\",\"required\":true}]"
            }
          },
          {
            "name": "User Resource Permission",
            "description": "Any authenticated user can access user resources. Fine-grained own-user check is enforced by the application.",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"User Resource\"]",
              "applyPolicies": "[\"Authenticated Users Policy\"]"
            }
          },
          {
            "name": "Team Resource Permission",
            "description": "Only managers can access team resources. Team attribute matching is enforced by the application.",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Team Resource\"]",
              "applyPolicies": "[\"Manager Role Policy\"]"
            }
          },
          {
            "name": "Default Permission",
            "description": "Default permission for authenticated users",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Default Resource\"]",
              "applyPolicies": "[\"Authenticated Users Policy\"]"
            }
          }
        ]
      }
    }
  ]
}
